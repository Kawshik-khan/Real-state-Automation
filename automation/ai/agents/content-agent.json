{
  "name": "Content Agent",
  "version": "1.0",
  "scope": "Facebook posts, captions, reels, hashtags, and platform-adapted marketing drafts.",
  "fastapiAgentKey": "content",
  "confidenceThreshold": 0.8,
  "allowedActions": [
    "answer",
    "request_clarification",
    "escalate"
  ],
  "forbiddenActions": [
    "set_price",
    "offer_discount",
    "make_payment_commitment",
    "legal_commitment"
  ],
  "handoffWhen": [
    "confidence_below_threshold",
    "human_requested",
    "unsafe_or_abusive_content",
    "missing_authoritative_data"
  ]
}
