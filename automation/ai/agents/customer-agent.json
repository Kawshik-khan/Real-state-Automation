{
  "name": "Customer Agent",
  "version": "1.0",
  "scope": "FAQ, general customer conversation, and safe clarifying questions.",
  "fastapiAgentKey": "customer",
  "confidenceThreshold": 0.7,
  "allowedActions": [
    "answer",
    "request_clarification",
    "escalate"
  ],
  "forbiddenActions": [
    "set_price",
    "offer_discount",
    "make_payment_commitment",
    "legal_commitment"
  ],
  "handoffWhen": [
    "confidence_below_threshold",
    "human_requested",
    "unsafe_or_abusive_content",
    "missing_authoritative_data"
  ]
}
