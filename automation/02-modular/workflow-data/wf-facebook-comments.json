{
  "name": "WF-Facebook-Comments (Modular)",
  "nodes": [
    {
      "name": "FB Comments Webhook",
      "typeVersion": 2.1,
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "facebook-comments",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "Normalize Input",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        224,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "pid",
              "name": "postId",
              "value": "={{ $json.body?.postId ?? $json.postId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "cid",
              "name": "commentId",
              "value": "={{ $json.body?.commentId ?? $json.commentId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "message",
              "value": "={{ $json.body?.message ?? $json.message ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "aid",
              "name": "authorId",
              "value": "={{ $json.body?.authorId ?? $json.authorId ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Moderate Comment",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        448,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/moderation/spam",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.message }}"
            },
            {
              "name": "source",
              "value": "facebook"
            },
            {
              "name": "authorId",
              "value": "={{ $json.authorId }}"
            }
          ]
        }
      }
    },
    {
      "name": "Is Clean?",
      "typeVersion": 2.3,
      "type": "n8n-nodes-base.if",
      "position": [
        672,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.verdict }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "clean"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Generate Reply",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/ai/respond",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "from",
              "value": "={{ $json.authorId }}"
            },
            {
              "name": "channel",
              "value": "facebook_comment"
            }
          ]
        }
      }
    },
    {
      "name": "Format Comment Reply",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "reply",
              "name": "reply",
              "value": "={{ $json.response?.reply ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Reply to Comment",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1344,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/social/facebook/comment",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "commentId",
              "value": "={{ $json.commentId }}"
            },
            {
              "name": "message",
              "value": "={{ $json.reply }}"
            }
          ]
        }
      }
    },
    {
      "name": "Respond",
      "typeVersion": 1,
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1568,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "FB Comments Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Moderate Comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Moderate Comment": {
      "main": [
        [
          {
            "node": "Is Clean?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Clean?": {
      "main": [
        [
          {
            "node": "Generate Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Reply": {
      "main": [
        [
          {
            "node": "Format Comment Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Comment Reply": {
      "main": [
        [
          {
            "node": "Reply to Comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reply to Comment": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "description": ""
}