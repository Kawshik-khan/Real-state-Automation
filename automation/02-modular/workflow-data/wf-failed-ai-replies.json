{
  "name": "WF-Failed-AI-Replies (Modular)",
  "nodes": [
    {
      "name": "Hourly Schedule",
      "typeVersion": 1.3,
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        432
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Failed Requests",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        224,
        432
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/failed?limit=50",
        "sendBody": false,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "name": "Has Failed Items?",
      "typeVersion": 2.3,
      "type": "n8n-nodes-base.if",
      "position": [
        448,
        432
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.items }}",
              "operator": {
                "type": "array",
                "operation": "notEmpty"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Extract Items",
      "typeVersion": 2,
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $json.items || [];\nif (items.length === 0) return [];\nreturn items.map(i => ({ json: i }));"
      }
    },
    {
      "name": "Process Each Failed Item",
      "typeVersion": 3,
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        896,
        288
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "name": "Retry AI API Call",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1120,
        192
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/retry",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "failedId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "conversationId",
              "value": "={{ $json.conversationId }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "channel",
              "value": "={{ $json.channel }}"
            }
          ]
        }
      }
    },
    {
      "name": "Retry Successful?",
      "typeVersion": 2.3,
      "type": "n8n-nodes-base.if",
      "position": [
        1344,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "completed"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Mark as Resolved",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1568,
        272
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/failed/resolve",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "failedId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "status",
              "value": "resolved"
            }
          ]
        }
      }
    },
    {
      "name": "Notify Admin of Failure",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1568,
        464
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/notifications/email",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $env.ADMIN_EMAIL }}"
            },
            {
              "name": "subject",
              "value": "=AI Reply Failed: {{ $json.conversationId }}"
            },
            {
              "name": "body",
              "value": "=Failed after retry: {{ $json.error }}"
            }
          ]
        }
      }
    },
    {
      "name": "Finalize Check",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "done",
              "name": "checkCompleted",
              "value": true,
              "type": "boolean"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Hourly Schedule": {
      "main": [
        [
          {
            "node": "Fetch Failed Requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Failed Requests": {
      "main": [
        [
          {
            "node": "Has Failed Items?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Failed Items?": {
      "main": [
        [
          {
            "node": "Extract Items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Finalize Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Items": {
      "main": [
        [
          {
            "node": "Process Each Failed Item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Each Failed Item": {
      "main": [
        [
          {
            "node": "Finalize Check",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Retry AI API Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry AI API Call": {
      "main": [
        [
          {
            "node": "Retry Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry Successful?": {
      "main": [
        [
          {
            "node": "Mark as Resolved",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Admin of Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark as Resolved": {
      "main": [
        [
          {
            "node": "Process Each Failed Item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Admin of Failure": {
      "main": [
        [
          {
            "node": "Process Each Failed Item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "description": ""
}