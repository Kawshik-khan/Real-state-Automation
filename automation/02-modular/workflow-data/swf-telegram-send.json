{
  "name": "SWF-Telegram-Send (Modular)",
  "nodes": [
    {
      "name": "Webhook",
      "typeVersion": 2.1,
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "send-telegram",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "Normalize Input",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        224,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "chatId",
              "name": "chatId",
              "value": "={{ $json.body?.chatId ?? $json.chatId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "message",
              "value": "={{ $json.body?.message ?? $json.message ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Send Telegram",
      "typeVersion": 1.1,
      "type": "n8n-nodes-base.telegram",
      "position": [
        480,
        300
      ],
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      }
    },
    {
      "name": "Respond to Webhook",
      "typeVersion": 1,
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        720,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'sent', chatId: $json.chatId } }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "telegram",
    "send"
  ],
  "description": "Outbound Telegram Send Subworkflow Node"
}
