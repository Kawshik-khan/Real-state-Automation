{
  "name": "WF-Scheduled-Posts (Modular)",
  "nodes": [
    {
      "name": "Daily Schedule (9AM)",
      "typeVersion": 1.3,
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        144
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "minutesInterval": 1440
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Approved Posts",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        224,
        144
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/content/approved?status=pending",
        "sendBody": false,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "name": "Extract Posts Array",
      "typeVersion": 2,
      "type": "n8n-nodes-base.code",
      "position": [
        448,
        144
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const posts = $json.posts || [];\nif (posts.length === 0) return [];\nreturn posts.map(p => ({ json: p }));"
      }
    },
    {
      "name": "Process Each Post",
      "typeVersion": 3,
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        672,
        144
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "name": "Route by Platform",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.switch",
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "facebook",
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "facebook"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "instagram",
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "instagram"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "linkedin",
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "linkedin"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Unknown"
        }
      }
    },
    {
      "name": "Finalize Batch",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "done",
              "name": "batchCompleted",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "time",
              "name": "completedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Daily Schedule (9AM)": {
      "main": [
        [
          {
            "node": "Fetch Approved Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Approved Posts": {
      "main": [
        [
          {
            "node": "Extract Posts Array",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Posts Array": {
      "main": [
        [
          {
            "node": "Process Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Each Post": {
      "main": [
        [
          {
            "node": "Finalize Batch",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route by Platform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Platform": {
      "main": [
        [
          {
            "node": "Process Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "description": ""
}