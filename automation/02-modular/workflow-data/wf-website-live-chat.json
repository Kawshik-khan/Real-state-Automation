{
  "name": "WF-Website-Live-Chat (Modular)",
  "nodes": [
    {
      "name": "Chat Webhook",
      "typeVersion": 2.1,
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "website-chat",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "Normalize Input",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        224,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "sid",
              "name": "sessionId",
              "value": "={{ $json.body?.sessionId ?? $json.sessionId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "message",
              "value": "={{ $json.body?.message ?? $json.message ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "uid",
              "name": "userId",
              "value": "={{ $json.body?.userId ?? $json.userId ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Process Chat AI",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        448,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/ai/respond",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "from",
              "value": "={{ $json.userId }}"
            },
            {
              "name": "channel",
              "value": "website"
            },
            {
              "name": "sessionId",
              "value": "={{ $json.sessionId }}"
            }
          ]
        }
      }
    },
    {
      "name": "Format Chat Reply",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        672,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "reply",
              "name": "reply",
              "value": "={{ $json.response?.reply ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "actions",
              "name": "suggestedActions",
              "value": "={{ $json.response?.suggestedActions ?? [] }}",
              "type": "json"
            }
          ]
        }
      }
    },
    {
      "name": "Respond",
      "typeVersion": 1,
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        960,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Chat Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Process Chat AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Chat AI": {
      "main": [
        [
          {
            "node": "Format Chat Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Chat Reply": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "description": ""
}