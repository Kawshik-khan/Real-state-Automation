            "index": 0
          }
        ]
      ]
    },
    "Route by Channel": {
      "main": [
        [
          {
            "node": "Send WhatsApp Brochure",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Facebook Brochure",
            "type": "main",
            "index": 0
          }
        ],
