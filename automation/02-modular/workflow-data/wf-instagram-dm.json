{
  "name": "WF-Instagram-DM (Modular)",
  "nodes": [
    {
      "name": "IG Webhook",
      "typeVersion": 2.1,
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "incoming-instagram",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "Normalize Input",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        224,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "uid",
              "name": "userId",
              "value": "={{ $json.body?.user?.id ?? $json.body?.userId ?? $json.userId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "message",
              "value": "={{ $json.body?.message?.text ?? $json.body?.text ?? $json.message ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "mid",
              "name": "messageId",
              "value": "={{ $json.body?.messageId ?? $json.messageId ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Validate DM",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        448,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/social/instagram/validate",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $json.userId }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        }
      }
    },
    {
      "name": "Process DM AI",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        672,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/ai/respond",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "from",
              "value": "={{ $json.userId }}"
            },
            {
              "name": "channel",
              "value": "instagram"
            }
          ]
        }
      }
    },
    {
      "name": "Send IG Reply",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        896,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/social/instagram/send",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "recipientId",
              "value": "={{ $json.userId }}"
            },
            {
              "name": "message",
              "value": "={{ $json.response?.reply ?? \"\" }}"
            }
          ]
        }
      }
    },
    {
      "name": "Respond",
      "typeVersion": 1,
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1120,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "IG Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Validate DM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate DM": {
      "main": [
        [
          {
            "node": "Process DM AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process DM AI": {
      "main": [
        [
          {
            "node": "Send IG Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send IG Reply": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "description": ""
}