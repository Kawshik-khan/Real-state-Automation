{
  "name": "SWF-AI-API-Caller (Modular)",
  "nodes": [
    {
      "name": "Webhook",
      "typeVersion": 2.1,
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "call-ai",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "Normalize Input",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        224,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "prompt",
              "name": "prompt",
              "value": "={{ $json.body?.prompt ?? $json.prompt ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "conv",
              "name": "conversationId",
              "value": "={{ $json.body?.conversationId ?? $json.conversationId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "uid",
              "name": "userId",
              "value": "={{ $json.body?.userId ?? $json.userId ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "ch",
              "name": "channel",
              "value": "={{ $json.body?.channel ?? $json.channel ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Call AI",
      "typeVersion": 4.4,
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/ai/respond",
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ $json.prompt }}"
            },
            {
              "name": "conversationId",
              "value": "={{ $json.conversationId }}"
            },
            {
              "name": "userId",
              "value": "={{ $json.userId }}"
            },
            {
              "name": "channel",
              "value": "={{ $json.channel }}"
            }
          ]
        }
      }
    },
    {
      "name": "Parse Response",
      "typeVersion": 3.4,
      "type": "n8n-nodes-base.set",
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "reply",
              "name": "reply",
              "value": "={{ $json.response?.reply ?? $json.reply ?? $json.text ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "conf",
              "name": "confidence",
              "value": "={{ $json.response?.confidence ?? $json.confidence ?? 1 }}",
              "type": "number"
            },
            {
              "id": "act",
              "name": "action",
              "value": "={{ $json.response?.action ?? $json.action ?? \"reply\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Respond to Webhook",
      "typeVersion": 1,
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        960,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Call AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call AI": {
      "main": [
        [
          {
            "node": "Parse Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "description": ""
}