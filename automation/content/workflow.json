          "headers": {
            "X-Automation-Secret": "glg-secret-key"
          }
        }
      },
      "name": "Call FastAPI Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 300]
    }
  ]
