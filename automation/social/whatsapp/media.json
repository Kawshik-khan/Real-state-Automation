{
  "name": "WhatsApp Media Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp/media",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger",
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "channel",
              "value": "whatsapp",
              "type": "string"
            },
            {
              "name": "sender",
              "value": "={{ $json.body.from || '' }}",
              "type": "string"
            },
            {
              "name": "mediaId",
              "value": "={{ $json.body.mediaId || '' }}",
              "type": "string"
            },
            {
              "name": "mediaType",
              "value": "={{ $json.body.mediaType || '' }}",
              "type": "string"
            },
            {
              "name": "conversationId",
              "value": "={{ $json.body.conversationId || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-request",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/api/v1/automation/media/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Tenant-Id",
              "value": "={{ $env.DEFAULT_TENANT_ID }}"
            },
            {
              "name": "X-Automation-Secret",
              "value": "={{ $env.AUTOMATION_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "fastapi-service",
      "name": "FastAPI Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'accepted', executionId: $execution.id } }}",
        "options": {}
      },
      "id": "acknowledge-webhook",
      "name": "Acknowledge Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Normalize Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Request": {
      "main": [
        [
          {
            "node": "FastAPI Service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI Service": {
      "main": [
        [
          {
            "node": "Acknowledge Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "pinData": {},
  "tags": [
    "whatsapp",
    "media"
  ]
}
