    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "twitter",
              "leftValue": "={{ $json.distribution_channels }}",
              "rightValue": "twitter",
              "operator": {
                "type": "array",
                "operation": "containsString"
              }
            }
          ],
