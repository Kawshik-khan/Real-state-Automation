{
  "name": "Content Distribution Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "content-distribute",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract content data\nconst contentData = $input.item.json;\n\nreturn {\n  content_id: contentData.content_id || `CONTENT-${Date.now()}`,\n  title: contentData.title,\n  body: contentData.body,\n  summary: contentData.summary || contentData.body.substring(0, 200),\n  media: contentData.media || [],\n  tags: contentData.tags || [],\n  category: contentData.category || 'general',\n  target_audience: contentData.target_audience || 'all',\n  distribution_channels: contentData.channels || ['facebook', 'instagram', 'linkedin'],\n  schedule: contentData.schedule || 'immediate',\n  campaign_id: contentData.campaign_id || null\n};"
      },
      "id": "extract-content",
      "name": "Extract Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format content for each platform\nconst content = $input.item.json;\n\nconst platformFormats = {\n  facebook: {\n    content: `${content.title}\\n\\n${content.body}\\n\\n#${content.tags.join(' #')}`,\n    max_length: 63206\n  },\n  instagram: {\n    content: `${content.title}\\n\\n${content.summary}\\n\\n#${content.tags.join(' #')}`,\n    max_length: 2200\n  },\n  linkedin: {\n    content: `${content.title}\\n\\n${content.body}\\n\\n#${content.tags.join(' #')}`,\n    max_length: 3000\n  },\n  twitter: {\n    content: `${content.title}\\n\\n${content.summary.substring(0, 100)}...\\n\\n#${content.tags.slice(0, 3).join(' #')}`,\n    max_length: 280\n  }\n};\n\nreturn {\n  ...content,\n  formatted_content: platformFormats\n};"
      },
      "id": "format-content",
      "name": "Format for Platforms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "scheduled",
              "leftValue": "={{ $json.schedule }}",
              "rightValue": "immediate",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-schedule",
      "name": "Check Schedule",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "unit": "hours"
      },
      "id": "schedule-delay",
      "name": "Schedule for Later",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "facebook",
              "leftValue": "={{ $json.distribution_channels }}",
              "rightValue": "facebook",
              "operator": {
                "type": "array",
                "operation": "containsString"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "route-facebook",
      "name": "Route to Facebook",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "resource": "page",
        "operation": "post",
        "pageId": "={{ $env.FACEBOOK_PAGE_ID }}",
        "text": "={{ $json.formatted_content.facebook.content }}",
        "additionalFields": {
          "link": "={{ $json.metadata?.link || '' }}",
          "images": "={{ $json.media }}"
        }
      },
      "id": "post-facebook",
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "instagram",
              "leftValue": "={{ $json.distribution_channels }}",
              "rightValue": "instagram",
              "operator": {
                "type": "array",
                "operation": "containsString"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "route-instagram",
      "name": "Route to Instagram",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 500]
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "upload",
        "caption": "={{ $json.formatted_content.instagram.content }}",
        "mediaUrl": "={{ $json.media[0] || '' }}",
        "additionalFields": {}
      },
      "id": "post-instagram",
      "name": "Post to Instagram",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [1450, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
