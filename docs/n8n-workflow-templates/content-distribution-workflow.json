      "id": "route-twitter",
      "name": "Route to Twitter/X",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 900]
    },
    {
      "parameters": {
        "resource": "tweet",
        "operation": "post",
        "text": "={{ $json.formatted_content.twitter.content }}",
        "additionalFields": {
          "media": "={{ $json.media }}"
        }
      },
      "id": "post-twitter",
      "name": "Post to Twitter/X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [1450, 900]
    },
    {
      "parameters": {
        "jsCode": "// Track engagement after posting\nconst content = $input.item.json;\nconst engagementTracking = {\n  content_id: content.content_id,\n  platforms: content.distribution_channels,\n  posted_at: new Date().toISOString(),\n  engagement_metrics: {\n    likes: 0,\n    comments: 0,\n    shares: 0,\n    clicks: 0,\n    impressions: 0\n  },\n  next_check: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString() // Check in 24 hours\n};\n\nreturn {\n  ...content,\n  engagement_tracking: engagementTracking\n};"
      },
      "id": "track-engagement",
      "name": "Track Engagement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1650, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/analytics/content",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content_id",
              "value": "={{ $json.content_id }}"
            },
            {
              "name": "title",
              "value": "={{ $json.title }}"
            },
            {
              "name": "category",
              "value": "={{ $json.category }}"
            },
            {
              "name": "posted_at",
              "value": "={{ $json.engagement_tracking.posted_at }}"
            },
            {
              "name": "platforms",
              "value": "={{ $json.distribution_channels }}"
            }
          ]
        },
        "options": {}
      },
      "id": "log-analytics",
      "name": "Log to Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1850, 500]
    },
    {
      "parameters": {
        "channel": "slack",
        "text": "=📤 Content Distributed\\n\\nContent ID: {{ $json.content_id }}\\nTitle: {{ $json.title }}\\nChannels: {{ $json.distribution_channels.join(', ') }}\\nCategory: {{ $json.category }}\\n\\nPosted at: {{ $json.engagement_tracking.posted_at }}",
        "otherOptions": {}
      },
      "id": "notify-marketing",
      "name": "Notify Marketing",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [2050, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, content_id: $json.content_id, title: $json.title, channels: $json.distribution_channels, posted_at: $json.engagement_tracking.posted_at, next_engagement_check: $json.engagement_tracking.next_check } }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2250, 500]
    }
