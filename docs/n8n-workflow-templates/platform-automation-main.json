{
  "name": "Platform Automation Main Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "platform-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "lead-created",
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "LeadCreated",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-event",
      "name": "Route Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Lead Created Handler\nconst leadData = $input.item.json.data;\n\n// Calculate lead score\nlet score = 0;\nif (leadData.budget > 500000) score += 30;\nelse if (leadData.budget > 200000) score += 20;\nelse score += 10;\n\nif (leadData.timeline === 'immediate') score += 25;\nelse if (leadData.timeline === '3-6 months') score += 15;\nelse score += 5;\n\nif (leadData.initial_intent === 'property_purchase') score += 20;\nelse if (leadData.initial_intent === 'rental') score += 15;\nelse score += 10;\n\nconst category = score > 70 ? 'hot' : score > 40 ? 'warm' : 'cold';\n\nreturn {\n  ...leadData,\n  calculated_score: score,\n  category: category,\n  processed_at: new Date().toISOString()\n};"
      },
      "id": "lead-handler",
      "name": "Lead Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "jsCode": "// Booking Created Handler\nconst bookingData = $input.item.json.data;\n\n// Generate calendar event\nconst calendarEvent = {\n  summary: `Property Visit - ${bookingData.property_id}`,\n  description: `Property visit for customer ${bookingData.customer_id}`,\n  start: {\n    dateTime: `${bookingData.date}T${bookingData.time}:00`\n  },\n  end: {\n    dateTime: `${bookingData.date}T${bookingData.time}:00`\n  }\n};\n\nreturn {\n  ...bookingData,\n  calendar_event: calendarEvent,\n  processed_at: new Date().toISOString()\n};"
      },
      "id": "booking-handler",
      "name": "Booking Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "jsCode": "// Payment Completed Handler\nconst paymentData = $input.item.json.data;\n\n// Generate receipt\nconst receipt = {\n  receipt_id: `REC-${Date.now()}`,\n  payment_id: paymentData.payment_id,\n  amount: paymentData.amount,\n  currency: paymentData.currency,\n  transaction_id: paymentData.transaction_id,\n  booking_id: paymentData.booking_id,\n  customer_id: paymentData.customer_id,\n  issued_at: new Date().toISOString()\n};\n\nreturn {\n  ...paymentData,\n  receipt: receipt,\n  processed_at: new Date().toISOString()\n};"
      },
      "id": "payment-handler",
      "name": "Payment Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Tenant-Id",
              "value": "={{ $json.tenant_id || 'default' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tenant_id",
              "value": "={{ $json.tenant_id }}"
            },
            {
              "name": "customer_id",
              "value": "={{ $json.customer_id }}"
            },
            {
              "name": "source",
              "value": "={{ $json.source }}"
            },
            {
              "name": "initial_intent",
              "value": "={{ $json.initial_intent }}"
            }
          ]
        },
        "options": {}
      },
      "id": "sync-lead",
      "name": "Sync Lead to Platform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/bookings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
