        "options": {}
      },
      "id": "sync-booking",
      "name": "Sync Booking to Platform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "channel": "slack",
        "text": "=New {{ $json.category || 'lead' }} created: {{ $json.customer_id }} - {{ $json.initial_intent }} (Score: {{ $json.calculated_score }})",
        "otherOptions": {}
      },
      "id": "notify-lead",
      "name": "Notify Sales Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "channel": "whatsapp",
        "chatId": "={{ $json.customer_id }}",
        "text": "=Your property visit has been confirmed for {{ $json.date }} at {{ $json.time }}. We look forward to seeing you!",
        "options": {}
      },
      "id": "notify-booking",
      "name": "Send WhatsApp Confirmation",
      "type": "n8n-nodes-base.whatsappApi",
      "typeVersion": 1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "channel": "email",
        "subject": "=Payment Confirmation - {{ $json.payment_id }}",
        "emailType": "html",
        "body": "=Dear Customer,<br><br>Your payment of {{ $json.amount }} {{ $json.currency }} has been successfully received.<br><br>Transaction ID: {{ $json.transaction_id }}<br>Booking ID: {{ $json.booking_id }}<br><br>Thank you for your payment!",
        "options": {}
      },
      "id": "send-receipt",
      "name": "Send Email Receipt",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [850, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: 'Event processed', event_type: $json.event_type, processed_at: new Date().toISOString() } }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
