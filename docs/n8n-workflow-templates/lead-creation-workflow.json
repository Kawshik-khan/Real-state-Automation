{
  "name": "Lead Creation Workflow",
  "nodes": [
    {
      "parameters": {
        "event": "LeadCreated",
        "options": {}
      },
      "id": "event-trigger",
      "name": "Event Trigger",
      "type": "n8n-nodes-base.rabbitmqTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract lead data from event\nconst leadData = $input.item.json.data;\nreturn {\n  lead_id: leadData.lead_id,\n  customer_id: leadData.customer_id,\n  source: leadData.source,\n  initial_intent: leadData.initial_intent,\n  budget: leadData.budget,\n  preferred_location: leadData.preferred_location,\n  timeline: leadData.timeline\n};"
      },
      "id": "extract-data",
      "name": "Extract Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "budget-check",
              "leftValue": "={{ $json.budget }}",
              "rightValue": 100000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-budget",
      "name": "Check Budget",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Calculate lead score based on budget\nlet score = 0;\nif ($json.budget > 500000) score += 30;\nelse if ($json.budget > 200000) score += 20;\nelse score += 10;\n\nif ($json.timeline === 'immediate') score += 25;\nelse if ($json.timeline === '3-6 months') score += 15;\nelse score += 5;\n\nreturn {\n  ...$json,\n  score: score,\n  category: score > 70 ? 'hot' : score > 40 ? 'warm' : 'cold'\n};"
      },
      "id": "score-lead",
      "name": "Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://platform-api:8000/api/v1/n8n/events/lead-created",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $json.lead_id }}"
            },
            {
              "name": "customer_id",
              "value": "={{ $json.customer_id }}"
            },
            {
              "name": "source",
              "value": "={{ $json.source }}"
            },
            {
              "name": "initial_intent",
              "value": "={{ $json.initial_intent }}"
            }
          ]
        },
        "options": {}
      },
      "id": "publish-event",
      "name": "Publish to Platform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://crm-system/api/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $json.lead_id }}"
            },
            {
              "name": "customer_id",
              "value": "={{ $json.customer_id }}"
            },
            {
              "name": "score",
              "value": "={{ $json.score }}"
            },
            {
              "name": "category",
              "value": "={{ $json.category }}"
            }
          ]
        },
        "options": {}
      },
      "id": "sync-to-crm",
      "name": "Sync to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "channel": "slack",
        "text": "=New lead created: {{ $json.lead_id }} ({{ $json.category }}) - {{ $json.initial_intent }}",
        "otherOptions": {}
      },
      "id": "notify-sales",
      "name": "Notify Sales Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1450, 200]
    }
  ],
  "connections": {
