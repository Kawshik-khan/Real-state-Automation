      "parameters": {
        "channel": "whatsapp",
        "chatId": "={{ $json.customer_id }}",
        "text": "=💰 Payment Received Successfully!\\n\\n✅ Amount: {{ $json.amount }} {{ $json.currency }}\\n📝 Receipt ID: {{ $json.receipt.receipt_id }}\\n🔗 Transaction ID: {{ $json.transaction_id }}\\n📅 Booking: {{ $json.booking_id }}\\n\\nThank you for your payment! A detailed receipt has been sent to your email.",
        "options": {}
