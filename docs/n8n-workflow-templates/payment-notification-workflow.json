      "parameters": {
        "channel": "slack",
        "text": "=💰 LARGE PAYMENT RECEIVED\\n\\nCustomer: {{ $json.customer_id }}\\nAmount: {{ $json.amount }} {{ $json.currency }}\\nPayment ID: {{ $json.payment_id }}\\nTransaction ID: {{ $json.transaction_id }}\\nBooking ID: {{ $json.booking_id }}\\n\\nReceipt: {{ $json.receipt.receipt_id }}",
        "otherOptions": {}
      },
      "id": "alert-finance-large",
      "name": "Alert Finance (Large Payment)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "channel": "slack",
        "text": "=💵 Payment Received\\n\\nCustomer: {{ $json.customer_id }}\\nAmount: {{ $json.amount }} {{ $json.currency }}\\nPayment ID: {{ $json.payment_id }}\\nBooking ID: {{ $json.booking_id }}",
        "otherOptions": {}
      },
      "id": "notify-finance",
      "name": "Notify Finance Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [2050, 400]
    },
    {
      "parameters": {
        "jsCode": "// Schedule payment reminders if applicable\nconst payment = $input.item.json;\n\n// Check if this is an installment payment\nconst reminders = [];\n\n// If payment method indicates installment plan\nif (payment.payment_method === 'installment') {\n  // Schedule next payment reminder (30 days)\n  const nextPaymentDate = new Date();\n  nextPaymentDate.setDate(nextPaymentDate.getDate() + 30);\n  \n  reminders.push({\n    type: 'next_payment_reminder',\n    scheduled_for: nextPaymentDate.toISOString(),\n    days_until: 30\n  });\n}\n\nreturn {\n  ...payment,\n  scheduled_reminders: reminders\n};"
      },
      "id": "schedule-reminders",
      "name": "Schedule Payment Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2250, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, payment_id: $json.payment_id, receipt_id: $json.receipt.receipt_id, amount: $json.amount, currency: $json.currency, synced_to_erp: true, synced_to_crm: true, notifications_sent: true, scheduled_reminders: $json.scheduled_reminders.length, processed_at: new Date().toISOString() } }}"
      },
      "id": "respond",
      "name": "Respond to Event",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2450, 300]
    }
