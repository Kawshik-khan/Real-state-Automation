{
  "name": "Lead Qualification and Scoring Workflow",
  "nodes": [
    {
      "parameters": {
        "event": "LeadCreated",
        "options": {}
      },
      "id": "event-trigger",
      "name": "Lead Created Event",
      "type": "n8n-nodes-base.rabbitmqTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate lead data\nconst leadData = $input.item.json.data;\n\n// Validate required fields\nif (!leadData.lead_id || !leadData.customer_id) {\n  throw new Error('Missing required lead fields');\n}\n\nreturn {\n  lead_id: leadData.lead_id,\n  customer_id: leadData.customer_id,\n  source: leadData.source || 'unknown',\n  initial_intent: leadData.initial_intent || 'general_inquiry',\n  budget: leadData.budget || 0,\n  preferred_location: leadData.preferred_location || null,\n  timeline: leadData.timeline || 'unknown',\n  tenant_id: leadData.tenant_id || 'default'\n};"
      },
      "id": "extract-data",
      "name": "Extract Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// BANT Assessment\nconst lead = $input.item.json;\nlet score = 0;\nlet reasons = [];\n\n// Budget Assessment (0-30 points)\nif (lead.budget > 500000) {\n  score += 30;\n  reasons.push('High budget (>500k)');\n} else if (lead.budget > 200000) {\n  score += 20;\n  reasons.push('Medium budget (200k-500k)');\n} else if (lead.budget > 50000) {\n  score += 10;\n  reasons.push('Low budget (50k-200k)');\n}\n\n// Timeline Assessment (0-25 points)\nif (lead.timeline === 'immediate') {\n  score += 25;\n  reasons.push('Immediate timeline');\n} else if (lead.timeline === '3-6 months') {\n  score += 15;\n  reasons.push('3-6 month timeline');\n} else if (lead.timeline === '6-12 months') {\n  score += 10;\n  reasons.push('6-12 month timeline');\n}\n\n// Intent Assessment (0-20 points)\nif (lead.initial_intent === 'property_purchase') {\n  score += 20;\n  reasons.push('Purchase intent');\n} else if (lead.initial_intent === 'rental') {\n  score += 15;\n  reasons.push('Rental intent');\n} else if (lead.initial_intent === 'investment') {\n  score += 18;\n  reasons.push('Investment intent');\n}\n\n// Source Assessment (0-15 points)\nif (lead.source === 'referral') {\n  score += 15;\n  reasons.push('Referral source');\n} else if (lead.source === 'whatsapp') {\n  score += 10;\n  reasons.push('WhatsApp source');\n} else if (lead.source === 'website') {\n  score += 8;\n  reasons.push('Website source');\n}\n\n// Location Preference (0-10 points)\nif (lead.preferred_location) {\n  score += 10;\n  reasons.push('Location specified');\n}\n\n// Determine category\nlet category;\nif (score >= 70) {\n  category = 'hot';\n} else if (score >= 40) {\n  category = 'warm';\n} else {\n  category = 'cold';\n}\n\nreturn {\n  ...lead,\n  calculated_score: score,\n  category: category,\n  qualification_reasons: reasons,\n  assessed_at: new Date().toISOString()\n};"
      },
      "id": "bant-assessment",
      "name": "BANT Assessment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
